    const start = () => { if (!running) { running = true; this._sraf = requestAnimationFrame(loop); } };
    this._wheel = e => {
      if (e.ctrlKey || e.metaKey) return;
      e.preventDefault();
      const d = e.deltaMode === 1 ? e.deltaY * 22 : e.deltaMode === 2 ? e.deltaY * window.innerHeight : e.deltaY;
      target = Math.max(0, Math.min(maxY(), target + d));
      start();
    };
    window.addEventListener("wheel", this._wheel, { passive: false });
    this._sync = () => { if (!running) { target = window.scrollY; current = target; } };
    window.addEventListener("scroll", this._sync, { passive: true });
    this._setScrollTarget = y => { target = Math.max(0, Math.min(maxY(), y)); current = window.scrollY; };
  }

  animateTitle() {
    const h1 = document.getElementById("hero-title");
    if (!h1 || h1.dataset.split === "1") return;
    h1.dataset.split = "1";
    const SPRING = "cubic-bezier(0.17,0.89,0.32,1.22)";
    const nodes = [...h1.childNodes];
    const letters = [];
    h1.textContent = "";
    nodes.forEach(n => {
      if (n.nodeName === "BR") { h1.appendChild(document.createElement("br")); return; }
      [...(n.textContent || "")].forEach(ch => {
        const s = document.createElement("span");
        s.textContent = ch === " " ? "\u00A0" : ch;
        s.style.display = "inline-block";
        s.style.opacity = "0";
        s.style.transform = "translateY(24px)";
        s.style.transition = `opacity 520ms ease, transform 620ms ${SPRING}`;
        h1.appendChild(s);
        letters.push(s);
      });
    });
    letters.forEach((s, i) => { s.style.transitionDelay = `${180 + i * 34}ms`; });
    requestAnimationFrame(() => requestAnimationFrame(() => {
      letters.forEach(s => { s.style.opacity = "1"; s.style.transform = "none"; });
    }));
    const rule = document.getElementById("hero-underline");
    if (rule) {
      const total = 180 + letters.length * 34 + 120;
      rule.style.transition = `width 900ms cubic-bezier(0.16,1,0.3,1) ${total}ms`;
      requestAnimationFrame(() => requestAnimationFrame(() => { rule.style.width = "300px"; }));
    }
  }

  setupMotion() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const EASE = "cubic-bezier(0.16,1,0.3,1)";
    this.setupSmoothScroll();

    this.animateTitle();
    const SHIFT = 26;
    const hero = [...document.querySelectorAll("[data-hero]")];
    hero.forEach((el, i) => {
      el.style.opacity = "0";
      el.style.transform = `translateY(${SHIFT}px)`;
      el.style.transition = `opacity 1100ms ${EASE} ${140 + i * 150}ms, transform 1100ms ${EASE} ${140 + i * 150}ms`;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        el.style.opacity = "1";
        el.style.transform = "";
      }));
    });

    const SEL = [
      "#imoveis > h2",
      "#imoveis article",
      "#imoveis > div > div > div",
      "#imoveis > div > div > h3",
      "#imoveis > div > div > p",
      "#exclusivos h2",
      "#exclusivos > div > div > p",
      "#exclusivos .gradient-button",
      "#exclusivos .media-frame",
      "#diferenciais > h2",
      "#diferenciais article",
      "#avaliacoes > div:first-child",
      "#avaliacoes figure",
      "#faq > div > div",
      "#onde-estamos > div > div",
      "footer > div > div"
    ].join(",");
    const raw = [...document.querySelectorAll(SEL)].filter(el => !el.closest("[data-hero]"));
    const set = new Set(raw);
    const items = raw.filter(el => {
      let p = el.parentElement;
      while (p) { if (set.has(p)) return false; p = p.parentElement; }
      return true;
    });
    if (!("IntersectionObserver" in window)) return;
    items.forEach(el => {
      el.style.opacity = "0";
      el.style.transform = "translateY(30px)";
      el.style.willChange = "opacity, transform";
    });
    this._io = new IntersectionObserver((entries, obs) => {
      const shown = entries.filter(e => e.isIntersecting || e.boundingClientRect.bottom < 0);
      shown.forEach((e, i) => {
        const el = e.target;
        const base = el.style.transition && el.style.transition.includes("transform 420ms")
          ? "transform 420ms " + EASE + ", box-shadow 420ms ease, "
          : "";
        el.style.transition = `${base}opacity 1000ms ${EASE} ${i * 130}ms, transform 1000ms ${EASE} ${i * 130}ms`;
        el.style.opacity = "1";
        el.style.transform = "";
        obs.unobserve(el);
      });
    }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
    items.forEach(el => this._io.observe(el));

    const header = document.querySelector(".site-header");
    const video = document.getElementById("mh-hero-video");
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY || 0;
        if (header) header.classList.toggle("is-stuck", y > 40);
        if (video) video.style.translate = `0 ${Math.min(y * 0.14, 110)}px`;
        const vh = window.innerHeight;
        document.querySelectorAll(".media-frame image-slot").forEach(m => {
          const r = m.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) return;
          const off = (r.top + r.height / 2 - vh / 2) / vh;
          m.style.translate = `0 ${(-off * 26).toFixed(2)}px`;
        });
        items.forEach(el => {
          if (el.style.opacity !== "0") return;
          if (el.getBoundingClientRect().bottom < 0) {
            el.style.transition = "opacity 400ms ease, transform 400ms ease";
            el.style.opacity = "1";
            el.style.transform = "";
          }
        });
        ticking = false;
      });
    };
    const navLinks = [...document.querySelectorAll(".nav-link")];
    const ids = [...new Set(navLinks.map(a => a.getAttribute("href")).filter(h => h && h.startsWith("#")))];

    const easeInOutCubic = t => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const glideTo = (top, dur) => {
      const start = window.scrollY;
      const dist = top - start;
      if (Math.abs(dist) < 2) return;
      const t0 = performance.now();
      const step = now => {
        const p = Math.min((now - t0) / dur, 1);
        window.scrollTo(0, start + dist * easeInOutCubic(p));
        if (p < 1) this._raf = requestAnimationFrame(step);
      };
      this._raf = requestAnimationFrame(step);
    };

    this._onNavClick = e => {
      const a = e.target.closest('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute("href").slice(1);
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      const top = window.scrollY + target.getBoundingClientRect().top - 96;
      const dur = Math.min(1200, Math.max(520, Math.abs(top - window.scrollY) * 0.6));
      glideTo(Math.max(top, 0), dur);
      history.replaceState(null, "", "#" + id);
    };
    document.addEventListener("click", this._onNavClick);

    const setCurrent = () => {
      const mid = window.scrollY + window.innerHeight * 0.35;
      let active = null;
      ids.forEach(h => {
        const el = document.getElementById(h.slice(1));
        if (el && window.scrollY + el.getBoundingClientRect().top <= mid) active = h;
      });
      navLinks.forEach(a => a.classList.toggle("is-current", a.getAttribute("href") === active));
    };

    const onScrollAll = () => { onScroll(); setCurrent(); };
    onScrollAll();
    window.addEventListener("scroll", onScrollAll, { passive: true });
    this._onScroll = onScrollAll;
  }
  componentWillUnmount() {
    clearTimeout(this._t);
    clearInterval(this._loop);
    clearTimeout(this._motion);
    if (this._io) this._io.disconnect();
    if (this._onScroll) window.removeEventListener("scroll", this._onScroll);
    if (this._onNavClick) document.removeEventListener("click", this._onNavClick);
    if (this._raf) cancelAnimationFrame(this._raf);
    if (this._sraf) cancelAnimationFrame(this._sraf);
    if (this._wheel) window.removeEventListener("wheel", this._wheel);
    if (this._sync) window.removeEventListener("scroll", this._sync);
    document.removeEventListener("pointerdown", this._onInteract);
    document.removeEventListener("visibilitychange", this._onVis);
  }
  renderVals() {
    const pads = { "Compacto": "104px", "Padrão": "148px", "Amplo": "196px" };
    return {
      accent: this.props.accent ?? "#E8B563",
      sectionPad: pads[this.props.density] ?? "148px"
    };
  }
}

</script>
